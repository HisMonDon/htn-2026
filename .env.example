BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
GPTZERO_API_KEY=
USE_MOCKS=
# Optional
STAGEHAND_MODEL=
CONTROLLED_TARGET_URL=
TARGET_PORT=4100
API_PORT=4000
BROWSERBASE_SESSION_TIMEOUT_S=900
LINEAGE_CONTACT_EMAIL=
CORS_ORIGIN=
# strict (default), exploratory, or deep. exploratory accepts lower-confidence "probable" edges and
# recurses into them; deep also accepts thinner "related" crosslinks and recurses into those too,
# for a much deeper investigation graph. Never set past strict in production. TRAVERSAL_MODE takes
# precedence over PROVENANCE_MODE if both are set (same values); PROVENANCE_MODE is kept for compatibility.
TRAVERSAL_MODE=strict
PROVENANCE_MODE=
# Safety budgets applied to every traversal, regardless of mode
MAX_GRAPH_DEPTH=5
MAX_EXPANDED_NODES=25
MAX_EDGES=60
MAX_CHILDREN_PER_NODE=6
MAX_RELATED_CHILDREN_PER_NODE=4
MAX_PROBABLE_CHILDREN_PER_NODE=3
# Research tree retrieval (optional; in-memory BM25 when unset)
ELASTIC_URL=
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=
ELASTIC_INDEX=lineage-candidates
ELASTIC_SEMANTIC=true
ELASTIC_INFERENCE_ID=
# Web retrieval proposer (optional; runs alongside GPTZero, GPTZero-only when unset)
# Brave Search API key: https://api.search.brave.com
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_MAX_QUERIES=5
WEB_SEARCH_RESULTS_PER_QUERY=4
WEB_SEARCH_MAX_CANDIDATES=10
# Total web-search time budget per analyzed source (also bounds each request)
WEB_SEARCH_TIMEOUT_MS=10000
# Wider breadth used only in deep traversal mode
WEB_SEARCH_MAX_QUERIES_DEEP=8
WEB_SEARCH_MAX_CANDIDATES_DEEP=15
# Semantic Scholar citation graph (API key optional; unauthenticated API limits apply when blank)
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_MAX_REFERENCES=10
SEMANTIC_SCHOLAR_MAX_CITATIONS=10
SEMANTIC_SCHOLAR_TIMEOUT_MS=10000
