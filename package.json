{
  "name": "lineage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vitest",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "target": "node --env-file-if-exists=.env --import tsx server/target/main.ts",
    "loop": "node --env-file-if-exists=.env --import tsx server/scripts/loop.ts",
    "research": "node --env-file-if-exists=.env --import tsx server/scripts/research.ts"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.20.0",
    "@browserbasehq/stagehand": "^4.1.0",
    "@elastic/elasticsearch": "^9.5.1",
    "cheerio": "^1.2.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
